#!/usr/bin/env bash
# Example Linode/OpenClaw deployment environment.
# Copy to `linode.env` and replace placeholders for your host.

# Required for SSH-based deploy and copy steps.
SSH_HOST=your.server.ip.or.hostname
SSH_USER=root
SSH_KEY_PATH=~/.ssh/your_deploy_key

# Optional. Prefer SSH keys; do not store real passwords in git.
ROOT_PASSWORD=

# Optional. Set when the OpenClaw workspace is not auto-detected.
# Example:
# OPENCLAW_WORKSPACE=/root/openclaw-stock-home/.openclaw/workspace
OPENCLAW_WORKSPACE=
